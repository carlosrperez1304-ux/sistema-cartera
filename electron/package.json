{
  "name": "paytrack",
  "version": "1.0.0",
  "description": "PayTrack — Gestión de Cartera",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.paytrack.app",
    "productName": "PayTrack",
    "copyright": "7LABS",
    "publish": [
      {
        "provider": "github",
        "owner": "carlosrperez1304-ux",
        "repo": "sistema-cartera"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-activation.js",
      "activation.html",
      "splash.html",
      "assets/**"
    ]
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
